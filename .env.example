# Copy to .env and fill in. Never commit .env.

# --- OANDA (forex) ---
# Practice and live use DIFFERENT tokens and DIFFERENT hostnames. Keep both sets;
# the connector picks by trading mode and must never mix them.
OANDA_PRACTICE_API_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=
OANDA_LIVE_API_TOKEN=
OANDA_LIVE_ACCOUNT_ID=

# --- Alpaca (equities / crypto / options) ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
